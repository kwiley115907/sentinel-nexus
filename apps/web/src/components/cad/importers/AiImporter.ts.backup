import { generateCadBuildingFromPrompt } from "@/components/cad/generators/CadBuildingGenerator";

export type AiBlueprint = {
  prompt?: string;
  stories?: number;
  rooms?: unknown[];
  doors?: unknown[];
  windows?: unknown[];
  stairs?: unknown[];
  devices?: unknown[];
  walls?: unknown[];
};

export function convertAiBlueprintToCad(ai: AiBlueprint) {
  return generateCadBuildingFromPrompt(String(ai.prompt || ""));
}
