import { generateCadBuildingFromPrompt } from "@/components/cad/generators/CadBuildingGenerator";
import { generateExteriorWallsFromRooms } from "@/components/cad/generators/ExteriorWallGenerator";
import { generateInteriorWallsFromRooms } from "@/components/cad/generators/InteriorWallGenerator";
import { solveConnectedBuildingLayout } from "@/components/cad/engines/BuildingLayoutEngine";
import { solveFloorPlan } from "@/components/cad/solvers/FloorPlanSolver";
import { placeDoorsForRooms } from "@/components/cad/engines/DoorPlacementEngine";
import { placeWindowsOnExteriorWalls } from "@/components/cad/engines/WindowPlacementEngine";
import { placeStairsForBuilding } from "@/components/cad/engines/StairPlacementEngine";
import { planDoors } from "@/components/cad/planners/DoorPlanner";
import { planWindows } from "@/components/cad/planners/WindowPlanner";
import { planStairs } from "@/components/cad/planners/StairPlanner";
import type {
  CadBuildingModel,
  CadDevice,
  CadDoor,
  CadRoom,
  CadStair,
  CadWall,
  CadWindow,
} from "@/components/cad/geometry/BuildingGeometry";

export type AiBlueprint = {
  type?: string;
  buildingType?: string;
  prompt?: string;
  stories?: number;
  rooms?: any[];
  walls?: any[];
  doors?: any[];
  windows?: any[];
  stairs?: any[];
  devices?: any[];
};

const DEFAULT_HEIGHT = 3;

function num(value: unknown, fallback = 0) {
  const parsed = Number(value);
  return Number.isFinite(parsed) ? parsed : fallback;
}

function safeLayer(value: unknown) {
  const layer = String(value || "ARCHITECTURE").toUpperCase();
  if (["ARCHITECTURE", "FIRE_ALARM", "CCTV", "SECURITY", "ACCESS"].includes(layer)) {
    return layer as CadRoom["layer"];
  }
  return "ARCHITECTURE";
}

function getStories(ai: AiBlueprint) {
  const direct = num(ai.stories, 0);
  if (direct > 0) return Math.max(1, direct);

  const prompt = String(ai.prompt || "").toLowerCase();
  const match = prompt.match(/(\d+)\s*(story|stories|floor|floors)/);
  if (match) return Math.max(1, Number(match[1]));

  if (prompt.includes("two story") || prompt.includes("two-story")) return 2;
  if (prompt.includes("three story") || prompt.includes("three-story")) return 3;
  if (prompt.includes("four story") || prompt.includes("four-story")) return 4;

  return 1;
}

function normalizeRooms(ai: AiBlueprint, stories: number): CadRoom[] {
  const source = Array.isArray(ai.rooms) ? ai.rooms : [];

  return source.map((room, index) => {
    const floor = Math.max(1, num(room.floor, 1));
    const x = num(room.x, 0);
    const z = num(room.z ?? room.y, 0);
    const width = Math.max(2, num(room.width, 10));
    const depth = Math.max(2, num(room.depth ?? room.height, 10));

    return {
      id: String(room.id || `room-${index + 1}`),
      label: String(room.label || room.name || `Room ${index + 1}`),
      x,
      z,
      width,
      depth,
      height: Math.max(2.5, num(room.wallHeight ?? room.height3d ?? DEFAULT_HEIGHT, DEFAULT_HEIGHT)),
      stories,
      floor,
      shape: "RECTANGLE",
      layer: safeLayer(room.layer),
    };
  });
}

function roomBounds(room: CadRoom) {
  return {
    left: room.x - room.width / 2,
    right: room.x + room.width / 2,
    front: room.z - room.depth / 2,
    back: room.z + room.depth / 2,
  };
}

function wallIdKey(start: { x: number; z: number }, end: { x: number; z: number }) {
  const a = `${Math.round(start.x * 100) / 100},${Math.round(start.z * 100) / 100}`;
  const b = `${Math.round(end.x * 100) / 100},${Math.round(end.z * 100) / 100}`;
  return a < b ? `${a}|${b}` : `${b}|${a}`;
}

function generateWallsFromRooms(rooms: CadRoom[]): CadWall[] {
  const groups = new Map<string, CadWall[]>();

  for (const room of rooms) {
    const { left, right, front, back } = roomBounds(room);

    const walls: CadWall[] = [
      {
        id: `wall-${room.id}-north`,
        start: { x: left, z: front },
        end: { x: right, z: front },
        height: room.height,
        thickness: 0.28,
        label: "Exterior Wall",
        layer: "ARCHITECTURE",
      },
      {
        id: `wall-${room.id}-south`,
        start: { x: left, z: back },
        end: { x: right, z: back },
        height: room.height,
        thickness: 0.28,
        label: "Exterior Wall",
        layer: "ARCHITECTURE",
      },
      {
        id: `wall-${room.id}-west`,
        start: { x: left, z: front },
        end: { x: left, z: back },
        height: room.height,
        thickness: 0.28,
        label: "Exterior Wall",
        layer: "ARCHITECTURE",
      },
      {
        id: `wall-${room.id}-east`,
        start: { x: right, z: front },
        end: { x: right, z: back },
        height: room.height,
        thickness: 0.28,
        label: "Exterior Wall",
        layer: "ARCHITECTURE",
      },
    ];

    for (const wall of walls) {
      const key = wallIdKey(wall.start, wall.end);
      groups.set(key, [...(groups.get(key) || []), wall]);
    }
  }

  return [...groups.entries()].map(([key, walls]) => {
    const wall = walls[0];
    const shared = walls.length > 1;

    return {
      ...wall,
      id: shared ? `interior-${key.replace(/[^a-zA-Z0-9]/g, "-")}` : wall.id,
      label: shared ? "Interior Wall" : "Exterior Wall",
      thickness: shared ? 0.16 : 0.32,
    };
  });
}

function normalizeWalls(ai: AiBlueprint, rooms: CadRoom[]): CadWall[] {
  if (!Array.isArray(ai.walls) || ai.walls.length === 0) {
    return generateWallsFromRooms(rooms);
  }

  return ai.walls.map((wall, index) => {
    const start = wall.start || { x: wall.x1, z: wall.z1 ?? wall.y1 };
    const end = wall.end || { x: wall.x2, z: wall.z2 ?? wall.y2 };

    return {
      id: String(wall.id || `wall-${index + 1}`),
      start: {
        x: num(start.x, 0),
        z: num(start.z ?? start.y, 0),
      },
      end: {
        x: num(end.x, 0),
        z: num(end.z ?? end.y, 0),
      },
      height: Math.max(2.5, num(wall.height, DEFAULT_HEIGHT)),
      thickness: Math.max(0.12, num(wall.thickness, 0.28)),
      label: String(wall.label || "Wall"),
      layer: safeLayer(wall.layer),
    };
  });
}

function wallAngle(wall: CadWall) {
  return Math.atan2(wall.end.z - wall.start.z, wall.end.x - wall.start.x);
}

function wallMidpoint(wall: CadWall) {
  return {
    x: (wall.start.x + wall.end.x) / 2,
    z: (wall.start.z + wall.end.z) / 2,
  };
}

function wallLength(wall: CadWall) {
  return Math.hypot(wall.end.x - wall.start.x, wall.end.z - wall.start.z);
}

function nearestExteriorWall(room: CadRoom, walls: CadWall[]) {
  return (
    walls.find((wall) => wall.id.includes(room.id) && wall.label?.includes("Exterior")) ||
    walls.find((wall) => wall.label?.includes("Exterior"))
  );
}

function normalizeDoors(ai: AiBlueprint, rooms: CadRoom[], walls: CadWall[]): CadDoor[] {
  if (Array.isArray(ai.doors) && ai.doors.length > 0) {
    return ai.doors.map((door, index) => ({
      id: String(door.id || `door-${index + 1}`),
      label: String(door.label || "Door"),
      x: num(door.x, 0),
      z: num(door.z ?? door.y, 0),
      width: Math.max(2.5, num(door.width, 3)),
      height: Math.max(2, num(door.height, 2.4)),
      rotation: num(door.rotation, 0),
      floor: Math.max(1, num(door.floor, 1)),
      layer: safeLayer(door.layer),
    }));
  }

  return rooms.map((room, index) => {
    const wall = nearestExteriorWall(room, walls);
    const point = wall ? wallMidpoint(wall) : { x: room.x, z: room.z - room.depth / 2 };

    return {
      id: `door-${room.id}`,
      label: index === 0 ? "Main Door" : "Door",
      x: point.x,
      z: point.z,
      width: index === 0 ? 4 : 3,
      height: 2.4,
      rotation: wall ? wallAngle(wall) : 0,
      floor: room.floor,
      layer: "ARCHITECTURE",
    };
  });
}

function normalizeWindows(ai: AiBlueprint, rooms: CadRoom[], walls: CadWall[], stories: number): CadWindow[] {
  if (Array.isArray(ai.windows) && ai.windows.length > 0) {
    return ai.windows.map((windowItem, index) => ({
      id: String(windowItem.id || `window-${index + 1}`),
      label: String(windowItem.label || `Window F${num(windowItem.floor, 1)}`),
      x: num(windowItem.x, 0),
      z: num(windowItem.z ?? windowItem.y, 0),
      width: Math.max(2, num(windowItem.width, 4)),
      height: Math.max(0.8, num(windowItem.height, 1.1)),
      sillHeight: Math.max(0.5, num(windowItem.sillHeight, 1.2)),
      rotation: num(windowItem.rotation, 0),
      floor: Math.max(1, num(windowItem.floor, 1)),
      storyHeight: Math.max(2.5, num(windowItem.storyHeight, DEFAULT_HEIGHT)),
      layer: safeLayer(windowItem.layer),
    }));
  }

  const exteriorWalls = walls.filter((wall) => wall.label === "Exterior Wall" && wallLength(wall) >= 4);

  return exteriorWalls.flatMap((wall) => {
    const mid = wallMidpoint(wall);
    const angle = wallAngle(wall);
    const width = Math.min(4, Math.max(2, wallLength(wall) * 0.35));

    return Array.from({ length: stories }).map((_, index) => ({
      id: `window-${wall.id}-f${index + 1}`,
      label: `Window F${index + 1}`,
      x: mid.x,
      z: mid.z,
      width,
      height: 1.1,
      sillHeight: 1.2,
      rotation: angle,
      floor: index + 1,
      storyHeight: wall.height,
      layer: "ARCHITECTURE",
    }));
  });
}

function normalizeStairs(ai: AiBlueprint, rooms: CadRoom[], stories: number): CadStair[] {
  if (stories <= 1) return [];

  if (Array.isArray(ai.stairs) && ai.stairs.length > 0) {
    return ai.stairs.map((stair, index) => ({
      id: String(stair.id || `stair-${index + 1}`),
      label: String(stair.label || `Stairs F${num(stair.floor, 1)} to F${num(stair.floor, 1) + 1}`),
      x: num(stair.x, rooms[0]?.x ?? 0),
      z: num(stair.z ?? stair.y, rooms[0]?.z ?? 0),
      width: Math.max(2.5, num(stair.width, 3)),
      depth: Math.max(4, num(stair.depth ?? stair.height, 5)),
      floor: Math.max(1, num(stair.floor, 1)),
      stories,
      storyHeight: Math.max(2.5, num(stair.storyHeight, rooms[0]?.height ?? DEFAULT_HEIGHT)),
      rotation: num(stair.rotation, Math.PI / 2),
      layer: safeLayer(stair.layer),
    }));
  }

  const anchor = rooms.find((room) => room.label.toLowerCase().includes("corridor")) || rooms[0];

  return Array.from({ length: stories - 1 }).map((_, index) => ({
    id: `stair-f${index + 1}-to-f${index + 2}`,
    label: `Stairs F${index + 1} to F${index + 2}`,
    x: anchor.x + anchor.width / 2 - 2,
    z: anchor.z,
    width: 3,
    depth: 5,
    floor: index + 1,
    stories,
    storyHeight: anchor.height,
    rotation: Math.PI / 2,
    layer: "ARCHITECTURE",
  }));
}

function normalizeDevices(ai: AiBlueprint, rooms: CadRoom[]): CadDevice[] {
  if (Array.isArray(ai.devices) && ai.devices.length > 0) {
    return ai.devices.map((device, index) => ({
      id: String(device.id || `device-${index + 1}`),
      label: String(device.label || device.type || "SD"),
      type: String(device.type || device.label || "SMOKE"),
      x: num(device.x, 0),
      z: num(device.z ?? device.y, 0),
      y: device.y3d !== undefined ? num(device.y3d, 2.7) : device.y !== undefined ? num(device.y, 2.7) : undefined,
      floor: Math.max(1, num(device.floor, 1)),
      storyHeight: Math.max(2.5, num(device.storyHeight, DEFAULT_HEIGHT)),
      wallMounted: Boolean(device.wallMounted),
      layer: safeLayer(device.layer || "FIRE_ALARM"),
    }));
  }

  return rooms.flatMap((room) =>
    Array.from({ length: room.stories }).flatMap((_, index) => [
      {
        id: `sd-${room.id}-f${index + 1}`,
        label: "SD",
        type: "SMOKE_DETECTOR",
        x: room.x,
        z: room.z,
        floor: index + 1,
        storyHeight: room.height,
        layer: "FIRE_ALARM",
      },
      {
        id: `hs-${room.id}-f${index + 1}`,
        label: "HS",
        type: "HORN_STROBE",
        x: room.x + room.width / 2 - 0.3,
        z: room.z,
        y: index * room.height + 2.2,
        floor: index + 1,
        storyHeight: room.height,
        wallMounted: true,
        layer: "FIRE_ALARM",
      },
    ]),
  );
}

export function convertAiBlueprintToCad(ai: AiBlueprint): CadBuildingModel {
  const stories = getStories(ai);
  const rawRooms = normalizeRooms(ai, stories);
  const rooms = solveFloorPlan(rawRooms);

  if (rawRooms.length === 0) {
    return generateCadBuildingFromPrompt(String(ai.prompt || ""));
  }

  const walls =
    Array.isArray(ai.walls) && ai.walls.length > 0
      ? normalizeWalls(ai, rooms)
      : [
          ...generateExteriorWallsFromRooms(rooms),
          ...generateInteriorWallsFromRooms(rooms),
        ];
  const doors = Array.isArray(ai.doors) && ai.doors.length > 0 ? normalizeDoors(ai, rooms, walls) : planDoors({ rooms, walls });
  const windows = Array.isArray(ai.windows) && ai.windows.length > 0 ? normalizeWindows(ai, rooms, walls, stories) : planWindows({ walls, stories });
  const stairs = Array.isArray(ai.stairs) && ai.stairs.length > 0 ? normalizeStairs(ai, rooms, stories) : planStairs({ rooms, stories });
  const devices = normalizeDevices(ai, rooms);

  return {
    stories,
    rooms,
    walls,
    doors,
    windows,
    stairs,
    devices,
  };
}
