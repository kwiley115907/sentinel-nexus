import { NextRequest, NextResponse } from "next/server";

export const runtime = "nodejs";

type ChatRequest = {
  prompt?: string;
  message?: string;
  conversationId?: string;
  blueprint?: unknown;
  projectId?: string;
};

export async function POST(request: NextRequest) {
  try {
    const body = (await request.json()) as ChatRequest;

    const prompt =
      typeof body.prompt === "string"
        ? body.prompt.trim()
        : typeof body.message === "string"
          ? body.message.trim()
          : "";

    if (!prompt) {
      return NextResponse.json(
        {
          success: false,
          error: "A prompt or message is required.",
        },
        { status: 400 },
      );
    }

    const aiBaseUrl = process.env.SENTINEL_AI_URL;

    if (!aiBaseUrl) {
      console.error("SENTINEL_AI_URL is not configured.");

      return NextResponse.json(
        {
          success: false,
          error: "The Sentinel AI service is not configured.",
        },
        { status: 500 },
      );
    }

    const aiUrl = `${aiBaseUrl.replace(/\/$/, "")}/gateway`;

    const aiResponse = await fetch(aiUrl, {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
        ...(process.env.SENTINEL_AI_SECRET
          ? {
              Authorization: `Bearer ${process.env.SENTINEL_AI_SECRET}`,
            }
          : {}),
      },
      body: JSON.stringify({
        requestType: "chat",
        prompt,
        conversationId: body.conversationId,
        blueprint: body.blueprint,
        projectId: body.projectId,
      }),
      cache: "no-store",
      signal: AbortSignal.timeout(120000),
    });

    const responseText = await aiResponse.text();

    let aiData: unknown;

    try {
      aiData = responseText ? JSON.parse(responseText) : {};
    } catch {
      aiData = {
        reply: responseText,
      };
    }

    if (!aiResponse.ok) {
      console.error("Sentinel AI service error:", {
        status: aiResponse.status,
        response: aiData,
      });

      return NextResponse.json(
        {
          success: false,
          error: "The Sentinel AI service returned an error.",
          details: aiData,
        },
        { status: aiResponse.status },
      );
    }

    return NextResponse.json({
      success: true,
      data: aiData,
    });
  } catch (error) {
    console.error("Sentinel AI route error:", error);

    const message =
      error instanceof Error ? error.message : "Unknown server error";

    return NextResponse.json(
      {
        success: false,
        error:
          message.includes("timeout") ||
          message.includes("aborted")
            ? "The AI service took too long to respond."
            : "Unable to contact the Sentinel AI service.",
      },
      { status: 500 },
    );
  }
}
